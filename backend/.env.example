# ============================================================
# Backend Environment Configuration Template
# 복사하여 .env 로 이름을 변경한 후 실제 키를 입력하세요.
# ============================================================

# OpenAI API Key (필수: OpenAI 대시보드에서 발급받은 키)
OPENAI_API_KEY=your_openai_api_key_here

# 국가법령정보센터 Open API Key (선택: open.law.go.kr에서 발급받은 OC 키)
LAW_API_KEY=your_law_api_oc_key_here

# JWT 토큰 암호화 시크릿 키 (보안을 위해 강력한 랜덤 문자열로 변경하세요)
JWT_SECRET_KEY=generate_a_secure_random_key_here

# 서버 포트 (기본값: 8001)
PORT=8001

# CORS 허용 Origin (콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.vercel.app
